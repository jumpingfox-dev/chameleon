{
  "appearance": {
    "fonts": {
      "headingFont": "Outfit",
      "bodyFont": "Plus Jakarta Sans"
    },
    "theme": "default",
    "icons": "fluent",
    "genreCards": "icons",
    "bottomBar": ["home", "search", "downloads", "settings"],
    "menuPinned": false,
    "screensaver": {
      "styleOnTv": "backdrops",
      "styleElsewhere": "off",
      "startAfter": 3,
      "dimAfter": 5,
      "dim": 0,
      "backdrops": {
        "backdropContent": "all",
        "backdropSeconds": 15,
        "backdropMotion": true,
        "backdropDetails": true,
        "backdropClock": true
      },
      "posterWall": {
        "posterContent": "all",
        "posterRows": 3,
        "posterSpeed": "slow",
        "posterClock": false
      },
      "clock": {
        "clockFormat": "device",
        "clockDate": true,
        "clockSize": "large",
        "clockColor": "white",
        "clockArtwork": false
      },
      "floatingLogo": {
        "logoSize": "medium",
        "logoSpeed": "medium",
        "logoColor": "changing"
      }
    }
  },
  "home": ["carousel", "genres", "myMedia", "continueWatching", "nextUp", "recentlyAdded", "suggested"],
  "sections": {
    "carousel": { "showTitle": false, "limit": 8, "kinds": "all", "seconds": 8 },
    "myMedia": { "showTitle": true, "look": "pictures", "cardNames": false },
    "genres": { "showTitle": false, "cardNames": false, "genreCount": "all", "pick": "random", "chosen": [] },
    "continueWatching": {
      "showTitle": true,
      "limit": 20,
      "episodeTitles": true,
      "episodeTitleStyle": "both",
      "movieTitles": false,
      "cutoffDays": "never"
    },
    "nextUp": {
      "showTitle": true,
      "limit": 20,
      "episodeTitles": true,
      "episodeTitleStyle": "both",
      "cutoff": "server",
      "rewatching": "server"
    },
    "favorites": {
      "showTitle": true,
      "limit": 30,
      "kinds": ["Movie", "Series", "BoxSet"],
      "names": { "Movie": false, "Series": false, "BoxSet": false, "Season": true, "Episode": true },
      "sort": "random"
    },
    "recentlyAdded": { "showTitle": true, "limit": 30 },
    "recentlyAddedMovies": { "showTitle": true, "limit": 30 },
    "recentlyAddedSeries": { "showTitle": true, "limit": 30 },
    "suggested": { "showTitle": true, "limit": 30 },
    "becauseYouWatched": { "showTitle": true, "limit": 20, "basis": "last" },
    "collection": { "showTitle": true, "limit": 50 },
    "genre": { "showTitle": true, "limit": 30 }
  },
  "playback": {
    "episodes": {
      "skip": { "intro": "ask", "recap": "ask", "credits": "ask", "preview": "ask" },
      "autoplayNext": true,
      "countdownSeconds": 10,
      "stillWatchingAfter": 3
    },
    "streamingQuality": {
      "wifiBitrate": 0,
      "mobileBitrate": 8000000,
      "streamMode": "auto"
    },
    "seekingAndResuming": {
      "seekStep": 10,
      "seekAccelerates": true,
      "resume": "resume"
    },
    "subtitles": {
      "subtitleFont": "Noto Sans",
      "subtitleSize": "medium",
      "subtitleHeight": 4,
      "subtitleColor": "white",
      "subtitleBackground": "outline",
      "liftSubtitles": true
    },
    "audio": {
      "passthrough": false,
      "downmix": false,
      "nightMode": false
    },
    "video": {
      "aspect": "fit",
      "showRating": true,
      "trickplay": true,
      "engine": "auto"
    },
    "previews": {
      "previews": true,
      "previewDelay": 2
    }
  }
}
